# GuardGPT environment configuration example.
# Copy this file to .env and fill in real values.
# NEVER commit a real .env with secrets.

# MCP server endpoint the Agent connects to.
# The CLI (main.py --pipeline) auto-starts an MCP server if this is unreachable.
GUARDGPT_MCP_URL=http://127.0.0.1:8000/mcp

# Model downloads are disabled by default so offline validation is deterministic.
# Set to 1 only when the embedding model is not already cached locally.
# GUARDGPT_ALLOW_MODEL_DOWNLOAD=1

# Ollama generates answers and performs a separate structured output review.
# --check and --pipeline only check input and do not call Ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Optional: use a different installed model for the output reviewer.
# OLLAMA_AUDIT_MODEL=llama3.2
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.2

# JEV model (between Layer 2 Intent Intelligence and Layer 3 Policy Engine).
#   builtin   : rules over the Layer 2 intent + confidence (default, nothing to install)
#   finetuned : your fine-tuned JEV checkpoint (best_model.pt), loaded locally.
#               The builtin verdict stays as a floor: the model can make a verdict
#               stricter, never looser. If the checkpoint is missing or fails to
#               load, every request is BLOCKED with final_status=ERROR (jev_failed)
#               - it never silently falls back to "safe".
#   server    : external Jev-Style HTTP server at JEV_STYLE_URL
#   auto      : try the server first, fall back to builtin
JEV_STYLE_MODE=builtin

# --- finetuned mode -------------------------------------------------------
# The checkpoint ships in intent_classifier/jev_finetuned/best_model.pt. The base model folder
# must hold config.json, tokenizer.json, readout_config.json and jev_style_decision.py
# (Hugging Face: chaoliangUNSW/Jev-Style-0.8B-Decision-v3).
# JEV_CHECKPOINT=C:/path/to/GuardGPT/intent_classifier/jev_finetuned/best_model.pt
# JEV_BASE_MODEL_DIR=C:/Users/<you>/.cache/huggingface/hub/models--chaoliangUNSW--Jev-Style-0.8B-Decision-v3/snapshots/<hash>
# JEV_ADAPTER=C:/path/to/GuardGPT/jev_adapter_guardgpt.py   # matches the training prompt format
# JEV_DEVICE=cpu                                       # or cuda
# JEV_STATE_FORMAT=text                                # how the adapter passes the prompt (text | json)
# The model's label only counts when its confidence is at least this:
# JEV_MODEL_MIN_CONFIDENCE=0.55

# --- builtin rule thresholds ---------------------------------------------
# JEV_BLOCK_THRESHOLD=0.75   # uncorroborated unsafe label needs this to BLOCK
# JEV_FLAG_THRESHOLD=0.50    # total unsafe probability that still FLAGs
# JEV_FLAG_PEAK=0.40         # "safe" with one unsafe label this close -> FLAG

# --- carried risk (memory of earlier blocked turns in a chat) --------------
# A blocked turn raises the score to max(turn risk, DECAY * score); every other turn
# fades it to score * (SAFE_KEEP + (1 - SAFE_KEEP) * turn risk). While the score is at or
# above THRESHOLD, a JEV FLAG becomes BLOCK (still sent for review). Self-harm is excluded.
# JEV_CARRY_ENABLED=1        # 0 restores the old behaviour
# JEV_CARRY_THRESHOLD=0.50
# JEV_CARRY_DECAY=0.9
# JEV_CARRY_SAFE_KEEP=0.85

# --- server / auto mode ---------------------------------------------------
JEV_STYLE_URL=http://127.0.0.1:8765
JEV_STYLE_TIMEOUT=300

# --- Layer 2 ---------------------------------------------------------------
# Local folder of all-MiniLM-L6-v2 if it is not in the HuggingFace cache:
# GUARDGPT_EMBEDDING_MODEL=C:/models/all-MiniLM-L6-v2
# Ensemble weights (default shown):
# GUARDGPT_L2_WEIGHTS=head=0.2,anchors=0.6,dataset=0.2

# --- tools MCP server (the agent's Ollama / review / redaction tools) -------
# Started automatically on first use with a random port and a per-launch token. Leave unset
# unless you run `python -m mcp_server.tools_server` yourself, in which case set both values
# (the same on both sides) or calls are rejected.
# GUARDGPT_TOOLS_URL=http://127.0.0.1:8001/mcp
# GUARDGPT_TOOLS_TOKEN=

# --- dashboard (optional: python dashboard.py) -----------------------------
# GUARDGPT_DASHBOARD_PORT=8080

# Hugging Face token (placeholder - DO NOT commit a real value).
# HF_TOKEN=
